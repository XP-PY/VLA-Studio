<mujoco model="week 2 one-link arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.25 0.35 0.50" rgb2="0.02 0.03 0.05"
             width="512" height="3072"/>
    <material name="link_material" rgba="0.18 0.55 0.92 1"/>
  </asset>

  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1"
          rgba="0.18 0.20 0.22 1"/>
    <geom name="base" type="cylinder" pos="0 0 0.4"
          size="0.12 0.4" rgba="0.30 0.34 0.40 1"
          contype="0" conaffinity="0"/>
    <!-- 
      `contype`: When this geometry acts as a collider, it can collide with the following types of objects. 
                0 indicates that it does not produce any collisions. 
      `conaffinity`: The types of collisions this geometry is willing to engage with when it acts as a collision target. 
                0 indicates that it does not accept any collisions.
    -->

    <!--
      The link body frame {L} starts at (0, 0, 0.8) in the world frame {W}.
      Its z-axis hinge rotates the link in the world's x-y plane.
    -->
    <body name="link" pos="0 0 0.8">
      <joint name="shoulder" type="hinge" axis="0 0 1"
             limited="true" range="-1.5708 1.5708"
             damping="0.05" armature="0.01"/>

      <!-- A geom provides shape, collision, and inertial properties. -->
      <geom name="link_geom" type="capsule"
            fromto="0 0 0 0.6 0 0" size="0.045"
            mass="1" material="link_material"/>

      <!-- A site is a massless marker. Its local position is p_L=(0.6,0,0). -->
      <site name="tip" type="box" pos="0.6 0 0"
            size="0.035 0.022 0.012" rgba="1 0.35 0.15 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- ctrl is desired joint angle; actuator_force is the generated force. -->
    <position name="shoulder_position" joint="shoulder"
              kp="25" dampratio="1"
              ctrllimited="true" ctrlrange="-1.2 1.2"
              forcelimited="true" forcerange="-8 8"/>
  </actuator>
</mujoco>
