# Active single-arm source subset. Override RECORD_TASK to select another plate.
export RECORDING_NAME="single_table_clear_specified_plate"
export RECORD_REGISTRY_KEY="rm65_single_table_clear_a_specified_plate"
export RECORD_DATASET_ID="rm65_single_table_preparation_and_bussing"
export RECORD_SUBSET_ID="clear_a_specified_plate"
export RECORD_TASK="${RECORD_TASK:-Put the vegetable from the pink plate into the collection box.}"
export RECORD_NUM_EPISODES="${RECORD_NUM_EPISODES:-1}"
export RECORD_FPS="${RECORD_FPS:-30}"
export RECORD_ROBOT_CONFIG_PATH="${RECORD_ROBOT_CONFIG_PATH:-configs/rm65_wrist_top.yaml}"
