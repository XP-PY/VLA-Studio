# Active single-arm source subset. Override RECORD_TASK for another vegetable/plate pair.
export RECORDING_NAME="single_table_place_one_vegetable"
export RECORD_REGISTRY_KEY="rm65_single_table_place_one_vegetable"
export RECORD_DATASET_ID="rm65_single_table_preparation_and_bussing"
export RECORD_SUBSET_ID="place_one_vegetable"
export RECORD_TASK="${RECORD_TASK:-Place the tomato on the pink plate.}"
export RECORD_NUM_EPISODES="${RECORD_NUM_EPISODES:-1}"
export RECORD_FPS="${RECORD_FPS:-30}"
export RECORD_ROBOT_CONFIG_PATH="${RECORD_ROBOT_CONFIG_PATH:-configs/rm65_wrist_top.yaml}"
